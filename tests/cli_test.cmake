string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef suffix)
set(input "${CMAKE_CURRENT_BINARY_DIR}/fusion-cli-${suffix}-input.ppm")
set(second "${CMAKE_CURRENT_BINARY_DIR}/fusion-cli-${suffix}-second.ppm")
set(output "${CMAKE_CURRENT_BINARY_DIR}/fusion-cli-${suffix}-output.ppm")
set(png "${CMAKE_CURRENT_BINARY_DIR}/fusion-cli-${suffix}-output.png")
set(rejected "${CMAKE_CURRENT_BINARY_DIR}/fusion-cli-${suffix}-rejected.ppm")
set(alias "${CMAKE_CURRENT_BINARY_DIR}/fusion-cli-${suffix}-alias.ppm")
set(dash_name "-fusion-cli-${suffix}.ppm")
set(dash_input "${CMAKE_CURRENT_BINARY_DIR}/${dash_name}")
set(input_dir "${CMAKE_CURRENT_BINARY_DIR}/fusion-cli-${suffix}-directory")
set(empty_dir "${CMAKE_CURRENT_BINARY_DIR}/fusion-cli-${suffix}-empty")
if(EXISTS "${input_dir}" OR EXISTS "${empty_dir}")
    message(FATAL_ERROR "Test directory already exists")
endif()
file(MAKE_DIRECTORY "${input_dir}/nested" "${empty_dir}")
string(ASCII 64 127 200 pixel)
string(ASCII 200 127 64 other_pixel)
file(WRITE "${input}" "P6\n3 1\n255\n${pixel}${pixel}${pixel}")
file(WRITE "${second}" "P6\n1 1\n255\n${pixel}")
file(WRITE "${dash_input}" "P6\n3 1\n255\n${pixel}${pixel}${pixel}")
file(WRITE "${input_dir}/a.PPM" "P6\n3 1\n255\n${pixel}${pixel}${pixel}")
file(WRITE "${input_dir}/z.ppm" "P6\n3 1\n255\n${other_pixel}${other_pixel}${other_pixel}")
file(WRITE "${input_dir}/notes.md" "Test metadata")
file(WRITE "${input_dir}/nested/ignored.ppm" "P6\n1 1\n255\n${pixel}")
file(WRITE "${empty_dir}/notes.txt" "No images")

function(expect_success)
    execute_process(COMMAND "${EXE}" ${ARGN}
        WORKING_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}"
        RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "Command failed (${status}): ${ARGN}\n${stdout}\n${stderr}")
    endif()
endfunction()

function(expect_error expected)
    execute_process(COMMAND "${EXE}" ${ARGN}
        WORKING_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}"
        RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(status STREQUAL "0" OR NOT stderr MATCHES "${expected}")
        message(FATAL_ERROR "Expected error '${expected}' (${status}): ${ARGN}\n${stdout}\n${stderr}")
    endif()
endfunction()

expect_success(--help)
expect_success(--output "${output}" "${input}")
file(READ "${input}" input_bytes HEX)
file(READ "${output}" output_bytes HEX)
if(NOT input_bytes STREQUAL output_bytes)
    message(FATAL_ERROR "Single-input output differs from input")
endif()
expect_success(-o "${output}" --levels 1 "${input}" "${input}")
file(READ "${output}" output_bytes HEX)
if(NOT input_bytes STREQUAL output_bytes)
    message(FATAL_ERROR "Identical-input fusion differs from input")
endif()
expect_success(--output "${png}" --levels 2 -- "${dash_name}")
if(NOT EXISTS "${png}")
    message(FATAL_ERROR "PNG output was not created")
endif()
expect_success(-o "${output}" --levels 1 "${input_dir}")
file(READ "${output}" directory_bytes HEX)
expect_success(-o "${output}" --levels 1 "${input_dir}/a.PPM" "${input_dir}/z.ppm")
file(READ "${output}" files_bytes HEX)
if(NOT directory_bytes STREQUAL files_bytes)
    message(FATAL_ERROR "Directory input differs from its ordered image files")
endif()
expect_success(-o "${output}" --levels 1 "${input}" "${input_dir}")
file(READ "${output}" mixed_bytes HEX)
expect_success(-o "${output}" --levels 1 "${input}" "${input_dir}/a.PPM" "${input_dir}/z.ppm")
file(READ "${output}" files_bytes HEX)
if(NOT mixed_bytes STREQUAL files_bytes)
    message(FATAL_ERROR "Mixed file and directory inputs differ from explicit inputs")
endif()

expect_error("Output path is required")
expect_error("At least one input" --output "${rejected}")
expect_error("Missing value" --output)
expect_error("Levels must be a positive integer" -o "${rejected}" --levels 0 "${input}")
expect_error("Levels must be a positive integer" -o "${rejected}" --levels 1x "${input}")
expect_error("Levels must be a positive integer" -o "${rejected}" --levels -1 "${input}")
expect_error("Levels specified more than once" -o "${rejected}" --levels 1 --levels 2 "${input}")
expect_error("Output path specified more than once" -o "${rejected}" -o "${output}" "${input}")
expect_error("Unknown option" -o "${rejected}" --unknown "${input}")
expect_error("Invalid fusion pyramid level count" -o "${rejected}" --levels 4 "${input}")
expect_error("dimensions must match" -o "${rejected}" "${input}" "${second}")
expect_error("Cannot open" -o "${rejected}" "${input}.missing.ppm")
expect_error("Input directory contains no image files" -o "${rejected}" "${empty_dir}")
expect_error("Output path must not refer to an input" -o "${input_dir}/a.PPM" "${input_dir}")
file(WRITE "${input_dir}/unsupported.jpg" "not a supported format")
expect_error("Unsupported image format" -o "${rejected}" "${input_dir}")
file(REMOVE "${input_dir}/unsupported.jpg")
expect_error("Output path must not refer to an input" -o "${input}" "${input}")
file(CREATE_LINK "${input}" "${alias}" SYMBOLIC RESULT link_result)
if(NOT link_result STREQUAL "0")
    message(FATAL_ERROR "Cannot create test symlink: ${link_result}")
endif()
expect_error("Output path must not refer to an input" -o "${alias}" "${input}")
file(READ "${input}" input_after HEX)
if(NOT input_bytes STREQUAL input_after OR EXISTS "${rejected}")
    message(FATAL_ERROR "A failing command modified an input or wrote an output")
endif()

file(REMOVE "${input}" "${second}" "${output}" "${png}" "${rejected}" "${alias}" "${dash_input}")
file(REMOVE_RECURSE "${input_dir}" "${empty_dir}")
